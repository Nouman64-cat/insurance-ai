{"allContent":{"docusaurus-plugin-content-docs":{"default":{"loadedVersions":[{"versionName":"current","label":"Next","banner":null,"badge":false,"noIndex":false,"className":"docs-version-current","path":"/insurance-ai/","tagsPath":"/insurance-ai/tags","isLast":true,"routePriority":-1,"sidebarFilePath":"/app/sidebars.js","contentPath":"/app/docs","docs":[{"id":"architecture","title":"Architecture","description":"System diagram","source":"@site/docs/architecture.md","sourceDirName":".","slug":"/architecture","permalink":"/insurance-ai/architecture","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"id":"architecture","title":"Architecture","sidebar_position":2},"sidebar":"mainSidebar","previous":{"title":"Overview","permalink":"/insurance-ai/"},"next":{"title":"Tech Stack","permalink":"/insurance-ai/stack"}},{"id":"artifacts","title":"Artifact Upload & OCR","description":"The artifact system lets users attach physical documents (CNIC scans, salary slips, medical reports, X-rays, policy forms) to a case and automatically extract their contents via the OCR Engine (the platform's configured multimodal LLM, Gemini 2.5 Flash by default). Results are stored in the artifacts table and can be retrieved with a fresh presigned download URL at any time.","source":"@site/docs/artifacts.md","sourceDirName":".","slug":"/artifacts","permalink":"/insurance-ai/artifacts","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":7,"frontMatter":{"id":"artifacts","title":"Artifact Upload & OCR","sidebar_position":7},"sidebar":"mainSidebar","previous":{"title":"Case Management","permalink":"/insurance-ai/cases"},"next":{"title":"Fraud Detection Layer","permalink":"/insurance-ai/fraud-layer"}},{"id":"cases","title":"Case Management","description":"The case management module provides a full lifecycle for tracking insurance work items — underwriting proposals, claim investigations, and general inquiries. Every case has an audit trail, workflow state, assignment history, comments, and file attachments.","source":"@site/docs/cases.md","sourceDirName":".","slug":"/cases","permalink":"/insurance-ai/cases","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":6,"frontMatter":{"id":"cases","title":"Case Management","sidebar_position":6},"sidebar":"mainSidebar","previous":{"title":"Commission Earnings","permalink":"/insurance-ai/commission-earnings"},"next":{"title":"Artifact Upload & OCR","permalink":"/insurance-ai/artifacts"}},{"id":"chat-agent","title":"AI Copilot (Chat Agent)","description":"The copilot is a conversational agent embedded in the web portal (and the agent app's Chat screen) that can look things up, onboard leads, run the underwriting and claims pipelines, and navigate the UI — while every mutating action is gated in code, not just in the prompt.","source":"@site/docs/chat-agent.md","sourceDirName":".","slug":"/chat-agent","permalink":"/insurance-ai/chat-agent","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":10,"frontMatter":{"id":"chat-agent","title":"AI Copilot (Chat Agent)","sidebar_position":10},"sidebar":"mainSidebar","previous":{"title":"Fraud Detection Layer","permalink":"/insurance-ai/fraud-layer"},"next":{"title":"LLM Providers & Token Usage","permalink":"/insurance-ai/llm-providers"}},{"id":"client-apps","title":"Client Apps","description":"Both clients talk only to the API Gateway (:8010) — except the web portal's OCR and summarizer screens, which call those services directly via NEXTPUBLICOCRURL / NEXTPUBLICSUMMARIZERURL.","source":"@site/docs/client-apps.md","sourceDirName":".","slug":"/client-apps","permalink":"/insurance-ai/client-apps","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":12,"frontMatter":{"id":"client-apps","title":"Client Apps","sidebar_position":12},"sidebar":"mainSidebar","previous":{"title":"LLM Providers & Token Usage","permalink":"/insurance-ai/llm-providers"},"next":{"title":"Contributing","permalink":"/insurance-ai/contributing"}},{"id":"commission-earnings","title":"Commission Earnings","description":"The portal at /commissions now reads persisted accrued gross earnings from the tenant service. The mobile commission screen and copilot ledger, summary, payee and statement tools use that same backend. A policy's status never implies a commission payment.","source":"@site/docs/commission-earnings.md","sourceDirName":".","slug":"/commission-earnings","permalink":"/insurance-ai/commission-earnings","draft":false,"unlisted":false,"tags":[],"version":"current","frontMatter":{"id":"commission-earnings","title":"Commission Earnings"},"sidebar":"mainSidebar","previous":{"title":"Underwriting & Policy Lifecycle","permalink":"/insurance-ai/policy-lifecycle"},"next":{"title":"Case Management","permalink":"/insurance-ai/cases"}},{"id":"contributing","title":"Contributing","description":"Full team guide: Git Branch and Commit Naming Convention (ClickUp).","source":"@site/docs/contributing.md","sourceDirName":".","slug":"/contributing","permalink":"/insurance-ai/contributing","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":13,"frontMatter":{"id":"contributing","title":"Contributing","sidebar_position":13},"sidebar":"mainSidebar","previous":{"title":"Client Apps","permalink":"/insurance-ai/client-apps"}},{"id":"data-flow","title":"Data Flow","description":"Requirements/evidence gate (runs before either evaluate path below)","source":"@site/docs/data-flow.md","sourceDirName":".","slug":"/data-flow","permalink":"/insurance-ai/data-flow","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":7,"frontMatter":{"id":"data-flow","title":"Data Flow","sidebar_position":7},"sidebar":"mainSidebar","previous":{"title":"Services Reference","permalink":"/insurance-ai/services"},"next":{"title":"Database Schemas","permalink":"/insurance-ai/db-schemas"}},{"id":"db-schemas","title":"Database Schemas","description":"PostgreSQL","source":"@site/docs/db-schemas.md","sourceDirName":".","slug":"/db-schemas","permalink":"/insurance-ai/db-schemas","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":4,"frontMatter":{"id":"db-schemas","title":"Database Schemas","sidebar_position":4},"sidebar":"mainSidebar","previous":{"title":"Data Flow","permalink":"/insurance-ai/data-flow"},"next":{"title":"Underwriting & Policy Lifecycle","permalink":"/insurance-ai/policy-lifecycle"}},{"id":"fraud-layer","title":"Fraud Detection Layer","description":"The fraud detection layer is a purpose-built graph intelligence system that sits inside the Risk Engine. It combines a Memgraph graph database (relationship detection) with Google Gemini 2.5 Flash (probabilistic scoring) to catch coordinated fraud rings that purely statistical models miss.","source":"@site/docs/fraud-layer.md","sourceDirName":".","slug":"/fraud-layer","permalink":"/insurance-ai/fraud-layer","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":5,"frontMatter":{"id":"fraud-layer","title":"Fraud Detection Layer","sidebar_position":5},"sidebar":"mainSidebar","previous":{"title":"Artifact Upload & OCR","permalink":"/insurance-ai/artifacts"},"next":{"title":"AI Copilot (Chat Agent)","permalink":"/insurance-ai/chat-agent"}},{"id":"intro","title":"Overview","description":"insurance-ai is an AI-powered, multi-tenant life-insurance platform built for Pakistani insurers. It covers the full policy journey — lead intake, quotation, pre-underwriting clearance, AI underwriting, issuance, in-force servicing, and claims — on a FastAPI microservice backend with LLMs, a Memgraph fraud graph, and a Kafka event bus.","source":"@site/docs/intro.md","sourceDirName":".","slug":"/","permalink":"/insurance-ai/","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"id":"intro","slug":"/","title":"Overview","sidebar_position":1},"sidebar":"mainSi