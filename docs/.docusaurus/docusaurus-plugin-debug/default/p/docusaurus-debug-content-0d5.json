{"allContent":{"docusaurus-plugin-content-docs":{"default":{"loadedVersions":[{"versionName":"current","label":"Next","banner":null,"badge":false,"noIndex":false,"className":"docs-version-current","path":"/","tagsPath":"/tags","isLast":true,"routePriority":-1,"sidebarFilePath":"/app/sidebars.js","contentPath":"/app/docs","docs":[{"id":"architecture","title":"Architecture","description":"System diagram","source":"@site/docs/architecture.md","sourceDirName":".","slug":"/architecture","permalink":"/architecture","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"id":"architecture","title":"Architecture","sidebar_position":2},"sidebar":"mainSidebar","previous":{"title":"Overview","permalink":"/"},"next":{"title":"Tech Stack","permalink":"/stack"}},{"id":"artifacts","title":"Artifact Upload & OCR","description":"The artifact system lets users attach physical documents (CNIC scans, salary slips, medical reports, X-rays, policy forms) to a case and automatically extract their contents via the OCR Engine (Gemini 2.5 Flash). Results are stored in the artifacts table and can be retrieved with a fresh presigned download URL at any time.","source":"@site/docs/artifacts.md","sourceDirName":".","slug":"/artifacts","permalink":"/artifacts","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":7,"frontMatter":{"id":"artifacts","title":"Artifact Upload & OCR","sidebar_position":7}},{"id":"cases","title":"Case Management","description":"The case management module provides a full lifecycle for tracking insurance work items — underwriting proposals, claim investigations, and general inquiries. Every case has an audit trail, workflow state, assignment history, comments, and file attachments.","source":"@site/docs/cases.md","sourceDirName":".","slug":"/cases","permalink":"/cases","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":6,"frontMatter":{"id":"cases","title":"Case Management","sidebar_position":6}},{"id":"data-flow","title":"Data Flow","description":"Synchronous evaluate (primary path)","source":"@site/docs/data-flow.md","sourceDirName":".","slug":"/data-flow","permalink":"/data-flow","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":7,"frontMatter":{"id":"data-flow","title":"Data Flow","sidebar_position":7},"sidebar":"mainSidebar","previous":{"title":"Database Schemas","permalink":"/db-schemas"},"next":{"title":"Services Reference","permalink":"/services"}},{"id":"db-schemas","title":"Database Schemas","description":"PostgreSQL","source":"@site/docs/db-schemas.md","sourceDirName":".","slug":"/db-schemas","permalink":"/db-schemas","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":4,"frontMatter":{"id":"db-schemas","title":"Database Schemas","sidebar_position":4},"sidebar":"mainSidebar","previous":{"title":"Tech Stack","permalink":"/stack"},"next":{"title":"Data Flow","permalink":"/data-flow"}},{"id":"fraud-layer","title":"Fraud Detection Layer","description":"The fraud detection layer is a purpose-built graph intelligence system that sits inside the Risk Engine. It combines a Memgraph graph database (relationship detection) with Google Gemini 2.5 Flash (probabilistic scoring) to catch coordinated fraud rings that purely statistical models miss.","source":"@site/docs/fraud-layer.md","sourceDirName":".","slug":"/fraud-layer","permalink":"/fraud-layer","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":5,"frontMatter":{"id":"fraud-layer","title":"Fraud Detection Layer","sidebar_position":5}},{"id":"intro","title":"Overview","description":"insurance-ai is an AI-powered, multi-tenant insurance underwriting platform built for Pakistani insurance companies. It automates the risk evaluation pipeline — from proposal submission to an explainable AI decision — using a microservices architecture backed by LLMs, a graph database, and an event-driven Kafka bus.","source":