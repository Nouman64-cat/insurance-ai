aws_region             = "eu-south-1"
environment            = "production"
instance_type          = "m8g.4xlarge"
root_volume_size_gib   = 150
create_app_s3_bucket   = true

# Keep empty until DNS and HTTPS termination are configured. Then allow only
# the intended web traffic (prefer an ALB security group instead of CIDRs).
allowed_web_ingress_cidrs = []
