# Underwriting Workbench — copy to .env.local for `npm run dev` outside Docker (docker-compose.yml sets these itself).

# Browser-facing URLs (host ports)
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_OCR_URL=http://localhost:8014

# The portal (sign-in, "Back to the portal", portal pages, customer e-application links), this app, and the
# Automation Chat (which embeds case views).
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_UNDERWRITING_URL=http://localhost:3005
NEXT_PUBLIC_AUTOMATION_URL=http://localhost:3004

# Server-side gateway URL: http://api-gateway:8000 inside Docker, the host port outside it.
API_GATEWAY_INTERNAL_URL=http://localhost:8010

# Single sign-on cookie (must match the portal's). Leave SSO_COOKIE_DOMAIN empty on localhost; set it to the shared
# parent domain (e.g. .insurance.example.com) when the apps live on different subdomains.
SSO_COOKIE_NAME=insurance_sso
SSO_COOKIE_DOMAIN=
