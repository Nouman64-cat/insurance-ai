NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_OCR_URL=http://localhost:8014
DEEPGRAM_API_KEY=your_api_key

# The other apps (defaults shown). Underwriting links and the redirects from the old underwriting URLs go to the
# workbench; NEXT_PUBLIC_PORTAL_URL is this app's own public URL. Set all three to the deployed URLs.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_UNDERWRITING_URL=http://localhost:3005
NEXT_PUBLIC_AUTOMATION_URL=http://localhost:3004
# Single sign-on cookie shared with the Automation Chat and the Underwriting Workbench.
SSO_COOKIE_NAME=insurance_sso
SSO_COOKIE_DOMAIN=
