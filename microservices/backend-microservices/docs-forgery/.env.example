# Copy this file to .env and fill in the keys you use. .env is git-ignored: never commit it.
# Layer 1 (file and metadata checks) needs no keys. Layer 2 needs one provider.

# HTTP service: Layer 1 runs in a child process killed after this many seconds (0 disables the child process)
# LAYER1_TIMEOUT_SECONDS=120

# Which model reads the page: gemini (default) or groq
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MIN_INTERVAL_S=13
# GEMINI_MAX_RETRIES=3
# GEMINI_TIMEOUT_S=90

# Groq (vision model on the free tier: qwen/qwen3.8-27b)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MIN_INTERVAL_S=4
# GROQ_MAX_RETRIES=4
# GROQ_TIMEOUT_S=60

# Optional: write one JSON line per model call (status, seconds, tokens, model) to this file
# GEMINI_CALL_LOG=data/calls.jsonl

# Docker bundles Layer 3 at these paths (Compose sets them automatically).
# For manual execution outside Docker, set your own interpreter/model paths.
# PIXEL_PYTHON=/opt/pixel-venv/bin/python
# TRUFOR_DIR=/opt/trufor
# Optional: mounted, validated document calibration JSON; no thresholds are fabricated.
# PIXEL_THRESHOLDS=/app/data/calibration/thresholds.json
