# Copy this file to .env and fill in the values before running docker-compose.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# PostgreSQL is NOT a docker-compose service — run your own instance (local
# install, managed cloud DB, etc.) and create an empty database for the app.
# On macOS/Windows Docker Desktop, containers reach a host-installed Postgres
# via `host.docker.internal`. On Linux you may need `--add-host` or the
# host's LAN IP instead.
DATABASE_URL=postgresql+asyncpg://postgres:change_me@host.docker.internal:5432/insurance-ai

# ── Memgraph ──────────────────────────────────────────────────────────────────
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687

# ── Service URLs (used by api-gateway for internal routing) ──────────────────
TENANT_SERVICE_URL=http://tenant-service:8001
RISK_ENGINE_URL=http://risk-engine:8002
DECISION_ENGINE_URL=http://decision-engine:8003
TEXT_SUMMARIZER_URL=http://text-summarizer:8005

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OCR_URL=http://localhost:8014
NEXT_PUBLIC_SUMMARIZER_URL=http://localhost:8015


# -- LLM providers ------------------------------------------------------------
# Gemini / OpenAI / Anthropic API keys and models are configured in the app by a
# SuperAdmin (Platform → LLM Configuration) and stored encrypted in the database.
# They are NOT set here. chat-agent, risk-engine, ocr-engine and text-summarizer
# read the active primary/fallback provider from tenant-service.
#
# Optional env fallback (used only until a SuperAdmin configures the above, or if
# tenant-service is unreachable): GEMINI_API_KEY / GEMINI_MODEL for the primary,
# OPENAI_API_KEY / OPENAI_FALLBACK_MODEL then ANTHROPIC_API_KEY /
# ANTHROPIC_FALLBACK_MODEL for the fallback. Leave unset to rely purely on the UI.

# Encrypts the API keys a SuperAdmin enters (llm_provider_config). REQUIRED to
# store keys through the UI. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# Optional shared secret guarding tenant-service's /internal/* endpoints. When
# set, the LLM services send it as X-Internal-Secret. Leave blank in local dev
# (the gateway never exposes /internal/*).
INTERNAL_API_SECRET=

JWT_SECRET_KEY=your_secret_key

# ── OpenSanctions (PEP / sanctions / NACTA screening) ─────────────────────────
# Real API — get a key at https://www.opensanctions.org/api/ (free for
# journalism/civil-society/academic use). Without a key, sanctions/PEP
# screening falls back to the internal fictional watchlist (see
# services/tenant-service/services/compliance_engine.py) rather than failing.
OPENSANCTIONS_API_KEY=

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# Set this to your S3 bucket's ACTUAL region if it differs from AWS_REGION
# above (AWS_REGION is shared with SES below, which supports fewer regions
# than S3) — presigned URLs generated for the wrong region fail with a 400
# InvalidRequest error. Check via: curl -sI https://<bucket>.s3.amazonaws.com/
# and read the `x-amz-bucket-region` response header.
AWS_S3_REGION=us-east-1
S3_BUCKET_NAME=insurance-ai-dev

# ── Email (AWS SES SMTP) — used to send generated credentials to tenant admins
# and users after account creation ─────────────────────────────────────────────
EMAIL_PROVIDER=ses
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com

# Where the "Sign in" button in the credentials email points.
APP_LOGIN_URL=http://localhost:3000/login

# AWS SES SMTP credentials (EMAIL_PROVIDER=ses)
AWS_SES_USERNAME=your_ses_smtp_username
AWS_SES_PASSWORD=your_ses_smtp_password
AWS_IAM_KEY=your_aws_access_key_id
AWS_IAM_SECRET=your_aws_secret_access_key