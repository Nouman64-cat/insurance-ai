# Set to "demo" for demo environments: every auto-generated account password
# (new users, tenant admins, acquisition-source logins) becomes 12345678 instead
# of a random one, and the underwriting demo shortcuts are enabled (auto-filled
# e-application / ACR, self-settling payment, "continue anyway" past incomplete
# gates, one-click gate clearance, auto-verified pre-issuance requirements).
# Any other value (e.g. "prod") keeps passwords random and requires every step
# to be genuinely completed before the flow moves on.
ENV_VAR=your_environment

# Copy this file to .env and fill in the values before running docker-compose.

# Browser origins (comma-separated; no paths). Empty uses localhost/loopback only.
CORS_ALLOWED_ORIGINS=
# Production example: CORS_ALLOWED_ORIGINS=https://app.getinsuredai.com,https://ai.getinsuredai.com,https://underwriting.getinsuredai.com,https://claims.getinsuredai.com,https://customer.getinsuredai.com,https://support.getinsuredai.com,https://requests.getinsuredai.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# PostgreSQL is NOT a docker-compose service — run your own instance (local
# install, managed cloud DB, etc.) and create an empty database for the app.
# On macOS/Windows Docker Desktop, containers reach a host-installed Postgres
# via `host.docker.internal`. On Linux you may need `--add-host` or the
# host's LAN IP instead.
DATABASE_URL=postgresql+asyncpg://postgres:change_me@host.docker.internal:5432/insurance-ai

# ── Memgraph ──────────────────────────────────────────────────────────────────
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687

# ── Service URLs (used by api-gateway for internal routing) ──────────────────
TENANT_SERVICE_URL=http://tenant-service:8001
RISK_ENGINE_URL=http://risk-engine:8002
DECISION_ENGINE_URL=http://decision-engine:8003
TEXT_SUMMARIZER_URL=http://text-summarizer:8005

# Required for new customer signup: an existing ACTIVE Tenant.code in tenant-service.
# A tenant UUID or display name will not work. Never fall back to another insurer.
CM_WALKIN_TENANT_CODE=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OCR_URL=http://localhost:8014
# Front-end apps: the portal, the Underwriting Workbench and the Automation Chat link to (and sign in through) each other.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_UNDERWRITING_URL=http://localhost:3005
NEXT_PUBLIC_CLAIMS_URL=http://localhost:3011
NEXT_PUBLIC_AUTOMATION_URL=http://localhost:3004
# Single sign-on cookie shared by the three apps; set SSO_COOKIE_DOMAIN to the parent domain across subdomains.
SSO_COOKIE_NAME=insurance_sso
SSO_COOKIE_DOMAIN=


# -- LLM providers ------------------------------------------------------------
# Gemini / OpenAI / Anthropic API keys and models are configured in the app by a
# SuperAdmin (Platform → LLM Configuration) and stored encrypted in the database.
# They are NOT set here. chat-agent, risk-engine, ocr-engine and text-summarizer
# read the active primary/fallback provider from tenant-service.
#
# Optional env fallback (used only until a SuperAdmin configures the above, or if
# tenant-service is unreachable): GEMINI_API_KEY / GEMINI_MODEL for the primary,
# OPENAI_API_KEY / OPENAI_FALLBACK_MODEL then ANTHROPIC_API_KEY /
# ANTHROPIC_FALLBACK_MODEL for the fallback. Leave unset to rely purely on the UI.

# Encrypts the API keys a SuperAdmin enters (llm_provider_config). REQUIRED to
# store keys through the UI. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# Shared secret between the platform's own services, sent as X-Internal-Secret.
# REQUIRED: POST /tokens/usage (the token ledger) accepts nothing without it, so
# OCR, chat, risk and summariser usage is only recorded when this is set.
# It also guards tenant-service's /internal/* endpoints (the gateway never exposes them).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=

JWT_SECRET_KEY=your_secret_key

# ── OpenSanctions (PEP / sanctions / NACTA screening) ─────────────────────────
# Real API — get a key at https://www.opensanctions.org/api/ (free for
# journalism/civil-society/academic use). Without a key, sanctions/PEP
# screening falls back to the internal fictional watchlist (see
# microservices/backend-microservices/tenant-service/services/compliance_engine.py) rather than failing.
OPENSANCTIONS_API_KEY=

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# Set this to your S3 bucket's ACTUAL region if it differs from AWS_REGION
# above (AWS_REGION is shared with SES below, which supports fewer regions
# than S3) — presigned URLs generated for the wrong region fail with a 400
# InvalidRequest error. Check via: curl -sI https://<bucket>.s3.amazonaws.com/
# and read the `x-amz-bucket-region` response header.
AWS_S3_REGION=us-east-1
S3_BUCKET_NAME=insurance-ai-dev

# ── Email (AWS SES SMTP) — used to send generated credentials to tenant admins
# and users after account creation ─────────────────────────────────────────────
EMAIL_PROVIDER=ses
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com

# Where the "Sign in" button in the credentials email points.
APP_LOGIN_URL=http://localhost:3000/login

# AWS SES SMTP credentials (EMAIL_PROVIDER=ses)
AWS_SES_USERNAME=your_ses_smtp_username
AWS_SES_PASSWORD=your_ses_smtp_password
AWS_IAM_KEY=your_aws_access_key_id
AWS_IAM_SECRET=your_aws_secret_access_key
# OpenAI live voice — server-side chat-agent overrides (optional).
# An OpenAI provider configured in Platform → LLM Configuration also works.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_VOICE=cedar
OPENAI_VOICE_TRANSCRIBE_MODEL=gpt-transcribe

# Customer Service: separate schema/application and migration credentials.
CS_DB_OWNER_PASSWORD=
CS_DB_APP_PASSWORD=
NEXT_PUBLIC_CUSTOMER_SERVICE_URL=http://localhost:3008

# Superuser used ONLY by the audit-provision job (creates the `audit` schema and its roles) and by the audit tests (disposable databases).
# POSTGRES_DB must be the same database as in DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=insurance-ai

# ── Audit Service (tamper-evident audit ledger) ───────────────────────────────
# Separate schema (`audit`) and database roles, created by the audit-provision container. The application role can
# read the ledger and append events but has no UPDATE/DELETE anywhere; the owner role only runs migrations.
# Generate each with:  python -c "import secrets; print(secrets.token_hex(24))"
AUDIT_DB_OWNER_PASSWORD=
AUDIT_DB_APP_PASSWORD=
# Roles that may read the audit trail and run verification (tenant admins see their own tenant; SuperAdmin sees all).
AUDIT_READ_ROLES=SuperAdmin
# Set to false to stop the services queueing audit intents (the owning business operations are unaffected).
AUDIT_ENABLED=true
# Scheduled full-chain verification interval, seconds (default 6 hours).
AUDIT_VERIFY_INTERVAL_SECONDS=900

# ── Audit signed checkpoints (Stage 2) ──────────────────────────────────────────────────────────────────────
# Passwords/keys here are generated per installation (python -c "import secrets; print(secrets.token_hex(24))"). Private signing
# keys and their passphrase are NEVER configured here: `docker compose run --rm audit-signer-init` creates them inside
# Docker-managed volumes (or the host directory from docker-compose.protected-dir.yml).
AUDIT_DB_SIGNER_PASSWORD=
AUDIT_SIGNER_SERVICE_KEY=
AUDIT_SIGNING_ENABLED=true
AUDIT_SIGNING_PROVIDER=local
AUDIT_CHECKPOINT_EVENT_THRESHOLD=500
AUDIT_CHECKPOINT_INTERVAL_SECONDS=900
# Human label shown in the Audit Trail (the cryptographic identity of this installation is generated in its database).
AUDIT_ENVIRONMENT_LABEL=local-dev
# Optional: pin the fingerprint printed by the init step so a replaced trust registry is rejected.
AUDIT_TRUST_ANCHOR_FINGERPRINT=
# Optional: HOST_PROTECTED_DATA_DIR=/path/outside/the/repo   (see docker-compose.protected-dir.yml)

# ── Audit archive (Stage 3): cold storage in a local MinIO AIStor Free, compressed + encrypted, signed manifests ──
# Optional storage profile: docker compose --profile storage up -d minio
# AIStor Free license file, downloaded from MinIO and kept OUTSIDE the repository (chmod 600).
# Use an existing path on THIS host; macOS example: /Users/your-name/.config/insurance-ai/minio.license.
# Leave blank when not using archive/evaluation storage. MinIO refuses to start without a valid license.
AISTOR_LICENSE_FILE=
# Generate every secret locally; never commit them. Use long random values (e.g. `python3 -c "import secrets;print(secrets.token_urlsafe(30))"`).
# MinIO root account: used ONLY by the one-off minio-init job to create the bucket and identities. The application never receives it.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Least-privilege application identities. Writer: put/get/list, NO delete. Reader: get/list only.
AUDIT_ARCHIVE_BUCKET=insurance-audit-archive
AUDIT_ARCHIVE_WRITER_KEY=
AUDIT_ARCHIVE_WRITER_SECRET=
AUDIT_ARCHIVE_READER_KEY=
AUDIT_ARCHIVE_READER_SECRET=
# Hot window before events are archived (months). The retention_policies table (editable in the UI) overrides this per category/tenant.
AUDIT_HOT_RETENTION_MONTHS=6
AUDIT_ARCHIVING_ENABLED=true
AUDIT_ARCHIVE_SCHEDULE=monthly
AUDIT_ARCHIVE_COMPRESSION=zstd
# Removing archived months from PostgreSQL is a separate step and is OFF unless you turn it on. Keep it false in development.
AUDIT_AUTO_HOT_CLEANUP=false
AUDIT_CLEANUP_MODE=detach
AUDIT_CLEANUP_SAFETY_DAYS=7
# Development only: archive anything older than N seconds so the whole cycle can be watched in minutes (needs AUDIT_ENVIRONMENT_LABEL=local-dev).
AUDIT_ARCHIVE_TEST_MODE=false
AUDIT_ARCHIVE_TEST_HOT_SECONDS=120
AUDIT_ARCHIVE_INTERVAL_SECONDS=300
# Object Lock retention applied to every archived object (an anti-tamper window, NOT a legal retention period). GOVERNANCE | COMPLIANCE.
AUDIT_ARCHIVE_LOCK_MODE=GOVERNANCE
AUDIT_ARCHIVE_LOCK_DAYS=30
# ── Evaluation data lake (shared/evaluation): golden datasets, Bronze / Silver / Gold, in the same MinIO ──
# Its own bucket and its own least-privilege identity (minio-init creates both when EVAL_LAKE_ACCESS_KEY is set).
# The identity can put/get/list and set retention; it can delete only under _smoke/. Generate the secret locally.
EVAL_LAKE_BUCKET=eval-lake
EVAL_LAKE_ACCESS_KEY=
EVAL_LAKE_SECRET_KEY=
# GOVERNANCE (default): published objects are undeletable until the date unless a privileged user lifts it on purpose.
# COMPLIANCE: nobody can lift it (production only). NONE: no lock. Object lock can only be switched on when the bucket is created.
EVAL_LAKE_RETENTION_MODE=GOVERNANCE
EVAL_LAKE_RETENTION_DAYS=365
# Running a script on the host instead of in Docker? Point at the published port: EVAL_LAKE_ENDPOINT=http://localhost:9000
# The archive master key is NOT an env var: `docker compose run --rm audit-archive-init` creates it once, in its own volume.
# BACK THAT KEY UP SEPARATELY from the database and MinIO data. Without it archives cannot be decrypted.


# Idempotency rollout: optional accepts old unkeyed callers; required rejects them
# only on integrated endpoints. Update all callers before enabling required.
IDEMPOTENCY_ENFORCEMENT=optional
IDEMPOTENCY_RETENTION_DAYS=30
# Seconds between upkeep passes that erase expired replay bodies (0 disables). Identity rows are kept.
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600
# Risk Kafka jobs use a separate risk_engine schema. Locally these fall back to
# DATABASE_URL. Production should supply dedicated existing runtime/owner roles.
# RISK_DATABASE_URL=postgresql+asyncpg://risk_app:password@postgres/insurance_ai
# RISK_MIGRATION_DATABASE_URL=postgresql+asyncpg://risk_owner:password@postgres/insurance_ai
RISK_EVALUATION_LEASE_SECONDS=900

# Docs-forgery — schema docs_forgery, within the SAME PostgreSQL database.
# The connection address has no password; its password is loaded only by docs-forgery.
DOCS_FORGERY_DATABASE_URL=postgresql://docs_forgery_app@host.docker.internal:5432/insurance-ai
DOCS_FORGERY_URL=http://docs-forgery:8022
# Put DOCS_FORGERY_DB_PASSWORD=<generated-password> in ignored .env.docs-forgery (chmod 600), NOT this shared file.
DOCS_FORGERY_LEGACY_SCHEMA=dev
# Optional owner URL for the one-off provision job; otherwise POSTGRES_USER/PASSWORD are used:
DOCS_FORGERY_MIGRATION_DATABASE_URL=
