# Copy to eval.env (envctl.py provision does it and fills the random values). eval.env is never committed.
# Only these variables reach the evaluation containers; the repository .env does not.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://eval_app:<same password>@eval-postgres:5432/insurance_eval
JWT_SECRET_KEY=
INTERNAL_API_SECRET=
EVAL_MARKER_TOKEN=
EVAL_USER_PASSWORD=
# The model-backed OCR cases: a DEDICATED evaluation key (own project, own spending limit), never the production one.
# Empty: those cases are reported blocked_missing_credentials. Production's OCR model is OpenAI gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# Providers an evaluation may call (a key for any other provider is refused by the guard), and the run's spending cap in US dollars.
EVAL_ALLOWED_PROVIDERS=openai
EVAL_BUDGET_USD=1.00
