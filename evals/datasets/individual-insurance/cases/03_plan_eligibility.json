    "metadata": {"interface": "chat", "env_mode": "any", "confirmations": "auto_approve",
      "truth": [{"oracle": "plan_selection", "inputs": {"age": 35, "plan_code": "TERM_LIFE_SECURE", "coverage": 5000000, "term": 20, "income": 1200000}, "expect": "ok"}]}
