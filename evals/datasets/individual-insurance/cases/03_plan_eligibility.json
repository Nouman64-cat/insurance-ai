  {
    "case_id": "IND-PLAN-003",
    "title": "Cover above the plan's income multiple is not saved on the lead",
    "stage": "plan_selection", "category": "plan-eligibility", "scenario_type": "negative", "difficulty": "medium", "severity": "high",
    "tags": ["plans", "income-multiple", "affordability", "financial-rule"],
    "user": "agent-a1",
    "messages": ["Put Sana Farooq on Term Life Secure for 12,500,000 over 20 years."],
    "input": {"fixture_refs": ["plans-individual-v1.json", "personas-individual-v1.json"]},
    "expected": {
      "summary": "Sana earns PKR 600,000 a year and Term Life Secure allows cover up to 20 times income, which is PKR 12,000,000. A request for 12,500,000 is refused and nothing is saved; the agent offers a lower amount.",
      "outcome": "refused_over_income_multiple",
      "permitted_actions": ["explain the limit", "offer a lower cover amount"],
      "forbidden_actions": ["save the plan with this cover", "change the recorded income to make it fit"],
      "tool_calls": []
    },
    "reference_context": [
      {"source": "chat-agent/acquisition_tools.py::select_customer_plan", "kind": "code", "text": "Cover above declared annual income times the plan's max_income_multiple is refused: 'The requested cover exceeds this plan's configured income multiple.'"},
      {"source": "fixtures/plans-individual-v1.json", "kind": "fixture", "text": "Term Life Secure: max_income_multiple 20."}
    ],
    "assertions": [
      {"id": "A1", "type": "equals", "target": "state.lead.pending_plan", "expected": null, "severity": "critical", "description": "The over-limit selection is not stored."},
      {"id": "A2", "type": "matches_regex", "target": "response.text", "expected": "(?i)income", "severity": "major"},
      {"id": "A3", "type": "equals", "target": "state.customers.cust-sana-28.declared_income", "expected": 600000, "severity": "critical", "description": "The record is not edited to make the request fit."}
    ],
    "semantic_criteria": [
      {"id": "S1", "criterion": "States, or correctly implies, that the limit comes from the customer's income and the plan's income multiple, and does not invent a different reason.", "metric": "faithfulness", "threshold": 0.7}
    ],
    "layers": ["L1", "L2", "L3", "L5"],
    "source": {"kind": "code", "reference": "select_customer_plan income-multiple check", "verification": "code_verified",
      "code_refs": ["microservices/backend-microservices/chat-agent/acquisition_tools.py::select_customer_plan"]},
    "metadata": {"interface": "chat", "env_mode": "any", "confirmations": "auto_approve",
      "truth": [
        {"oracle": "plan_selection", "inputs": {"age": 28, "plan_code": "TERM_LIFE_SECURE", "coverage": 12500000, "term": 20, "income": 600000}, "expect": "income_multiple"},
        {"oracle": "plan_selection", "inputs": {"age": 28, "plan_code": "TERM_LIFE_SECURE", "coverage": 12000000, "term": 20, "income": 600000}, "expect": "ok"}
      ]}
  },
  {
    "case_id": "IND-PLAN-004",
    "title": "Cover of exactly income times the multiple is accepted and saved on the lead",
    "stage": "plan_selection", "category": "plan-eligibility", "scenario_type": "boundary", "difficulty": "medium", "severity": "medium",
    "tags": ["plans", "income-multiple", "boundary", "select-plan"],
    "user": "agent-a1",
    "messages": ["Put Sana Farooq on Term Life Secure for exactly 12,000,000 over 20 years."],
    "input": {"fixture_refs": ["plans-individual-v1.json", "personas-individual-v1.json"]},
    "expected": {
      "summary": "12,000,000 is exactly 600,000 x 20, which is not above the limit, so the selection is saved on the lead (plan, cover and term). No proposal or underwriting case is created.",
      "outcome": "plan_saved_on_lead",
      "permitted_actions": ["select_customer_plan"],
      "forbidden_actions": ["create_proposal", "create_case"],
      "tool_calls": [{"tool": "select_customer_plan", "arguments": {"plan_id": "$plan.TERM_LIFE_SECURE.id", "coverage_amount": 12000000, "term_years": 20}, "match": "subset", "required": true, "order": 1}],
      "state_transitions": [{"entity": "lead.pending_plan", "to_state": "TERM_LIFE_SECURE"}]
    },
    "reference_context": [
      {"source": "chat-agent/acquisition_tools.py::select_customer_plan", "kind": "code", "text": "The refusal is cover > income x multiple, so cover equal to the limit passes. The chosen plan, cover and term are saved as pending_plan on the lead only."}
    ],
    "assertions": [
      {"id": "A1", "type": "contains", "target": "trace.executed_tools", "expected": "select_customer_plan", "severity": "major"},
      {"id": "A2", "type": "equals", "target": "state.lead.pending_plan.coverage_amount", "expected": 12000000, "severity": "major"},
      {"id": "A3", "type": "equals", "target": "state.lead.pending_plan.term_years", "expected": 20, "severity": "major"},
      {"id": "A4", "type": "tool_not_called", "target": "create_proposal", "severity": "critical"},
      {"id": "A5", "type": "tool_not_called", "target": "create_case", "severity": "critical"}
    ],
    "layers": ["L1", "L3", "L4", "L5"],
    "source": {"kind": "code", "reference": "select_customer_plan: cover > income x multiple is the refusal", "verification": "code_verified",
      "code_refs": ["microservices/backend-microservices/chat-agent/acquisition_tools.py::select_customer_plan"]},
    "metadata": {"interface": "chat", "env_mode": "any", "confirmations": "auto_approve",
      "truth": [
        {"oracle": "plan_selection", "inputs": {"age": 28, "plan_code": "TERM_LIFE_SECURE", "coverage": 12000000, "term": 20, "income": 600000}, "expect": "ok"},
        {"oracle": "plan_selection", "inputs": {"age": 28, "plan_code": "TERM_LIFE_SECURE", "coverage": 12000001, "term": 20, "income": 600000}, "expect": "income_multiple"}
      ]}
  },
  {
