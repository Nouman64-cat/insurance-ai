    "semantic_criteria": [
      {"id": "S1", "criterion": "If the agent mentions why a plan is missing, the reason given (term would end past the plan's maximum maturity age) is accurate.", "metric": "faithfulness", "threshold": 0.7}
    ],
    "layers": ["L1", "L2", "L3", "L5"],
    "source": {"kind": "code", "reference": "select_customer_plan maturity-age test at the 52 / 53 boundary", "verification": "code_verified",
      "code_refs": ["microservices/backend-microservices/chat-agent/acquisition_tools.py::select_customer_plan"]},
    "metadata": {"interface": "chat", "env_mode": "any", "confirmations": "auto_approve",
      "truth": [
        {"oracle": "plan_choices", "inputs": {"age": 53}, "expect": ["TERM_LIFE_SECURE", "WHOLE_LIFE_LEGACY", "SINGLE_PREMIUM_SHIELD", "HEALTH_CASH_PLUS"]},
        {"oracle": "plan_choices", "inputs": {"age": 52}, "expect": ["TERM_LIFE_SECURE", "WHOLE_LIFE_LEGACY", "ENDOWMENT_SAVER", "SINGLE_PREMIUM_SHIELD", "HEALTH_CASH_PLUS"]}
      ]}
