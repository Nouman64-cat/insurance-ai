  {
    "case_id": "IND-PLAN-002",
    "title": "At 53 the Endowment Saver is left out because its term would run past the maturity age",
    "stage": "plan_selection", "category": "plan-eligibility", "scenario_type": "boundary", "difficulty": "hard", "severity": "high",
    "tags": ["plans", "maturity-age", "boundary", "eligibility"],
    "user": "agent-a1",
    "messages": ["What plans can Bashir Ahmed take?"],
    "input": {"fixture_refs": ["plans-individual-v1.json", "personas-individual-v1.json"]},
    "expected": {
      "summary": "Bashir is 53. His age is inside the Endowment Saver's entry band (18 to 55), but its shortest term of 10 years would end at 63, past the plan's maximum maturity age of 62. The Endowment Saver is therefore not offered; the other four active individual plans are.",
      "outcome": "plans_listed_without_endowment",
      "permitted_actions": ["select_customer_plan (compare only)"],
      "forbidden_actions": ["offer the Endowment Saver", "save a plan choice"],
      "tool_calls": [{"tool": "select_customer_plan", "arguments": {"customer_id": "$customer.cust-bashir-53.id"}, "match": "subset", "required": true, "order": 1}]
    },
    "reference_context": [
      {"source": "chat-agent/acquisition_tools.py::select_customer_plan", "kind": "code", "text": "A plan is eligible only if entry_age_min <= age <= entry_age_max and age + term_min_years <= max_maturity_age."},
      {"source": "fixtures/plans-individual-v1.json", "kind": "fixture", "text": "Endowment Saver: entry age 18 to 55, term 10 to 25 years, maximum maturity age 62."}
    ],
    "assertions": [
      {"id": "A1", "type": "tool_called", "target": "select_customer_plan", "severity": "major"},
      {"id": "A2", "type": "not_contains", "target": "response.text", "expected": "Endowment Saver", "severity": "critical", "description": "An ineligible plan is not offered."},
      {"id": "A3", "type": "contains", "target": "response.text", "expected": "Term Life Secure", "severity": "major"},
      {"id": "A4", "type": "equals", "target": "state.lead.pending_plan", "expected": null, "severity": "major"}
