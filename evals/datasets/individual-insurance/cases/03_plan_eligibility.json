    "reference_context": [
      {"source": "chat-agent/acquisition_tools.py::select_customer_plan", "kind": "code", "text": "With a plan chosen but no cover or term the tool answers 'What coverage amount and term has the customer chosen? No plan has been saved yet.'"}
