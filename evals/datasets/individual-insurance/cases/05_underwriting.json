  {
    "case_id": "IND-UW-005",
    "title": "A medical decline cannot be outweighed by good finances",
    "stage": "underwriting", "category": "underwriting", "scenario_type": "complex_workflow", "difficulty": "hard", "severity": "critical",
    "tags": ["underwriting", "decision-engine", "precedence", "decline"],
    "user": "uw-a1",
    "input": {
      "payload": {"operation": "underwriting.decide",
        "requirements_satisfied": true,
        "medical": {"risk_class": "Decline", "risk_score": 40},
        "financial": {"financially_justified": true, "referral_required": false},
        "fraud": {"severity": "Low", "probability": 0.05, "investigation_required": false},
        "findings": []}
    },
    "expected": {
      "summary": "The decision is Decline. The engine is a sequence of checks, not a weighted average, so strong finances and a low fraud signal do not cancel a medical Decline. Missing requirements come first (Request Additional Evidence) and a serious fraud signal comes next (Fraud Investigation).",
      "outcome": "Decline",
      "forbidden_actions": ["average the three assessments into a score", "approve with a loading"]
    },
    "reference_context": [
      {"source": "shared/underwriting/decision_rules.py::decide", "kind": "code", "text": "Order of checks: requirements not satisfied, fraud investigation, medium fraud, medical Decline, medical Postpone, medical review, financial justification, high verification findings, loading, financial referral, medium findings, otherwise Auto Approve."}
    ],
    "assertions": [
      {"id": "A1", "type": "equals", "target": "result.decision", "expected": "Decline", "severity": "critical"},
      {"id": "A2", "type": "not_equals", "target": "result.decision", "expected": "Auto Approve", "severity": "critical"}
    ],
    "layers": ["L1", "L4", "L5"],
    "source": {"kind": "code", "reference": "decide() rule chain", "verification": "code_verified",
      "code_refs": ["shared/underwriting/decision_rules.py::decide"],
      "notes": "The ordering is the documented design of the engine (severe risk is never cancelled by a favourable score); the outcome for each input is run against the real function."},
    "metadata": {"interface": "rules", "env_mode": "any",
      "truth": [
        {"oracle": "decide", "inputs": {"medical_class": "Decline", "justified": true}, "expect": "Decline"},
        {"oracle": "decide", "inputs": {"fraud_severity": "High", "fraud_probability": 0.9, "fraud_investigation": true}, "expect": "Fraud Investigation"},
        {"oracle": "decide", "inputs": {"requirements_satisfied": false, "medical_class": "Decline"}, "expect": "Request Additional Evidence"},
        {"oracle": "decide", "inputs": {"medical_class": "Substandard", "medical_loading": 25}, "expect": "Approve with Loading"}
      ]}
