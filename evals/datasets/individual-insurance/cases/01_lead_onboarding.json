  {
    "case_id": "IND-LEAD-006",
    "title": "A prospect's details arrive over three messages and the agent never invents a date of birth",
    "stage": "lead",
    "category": "lead-onboarding",
    "scenario_type": "complex_workflow",
    "difficulty": "hard",
    "severity": "high",
    "tags": [
      "lead",
      "multi-turn",
      "no-fabrication",
      "plan-comparison"
    ],
    "user": "agent-a1",
    "messages": [
      "I met a prospect today, Rabia Anwar, phone 0322-5550130.",
      "She is a 31 year old graphic designer in Islamabad earning about 900,000 a year, female.",
      "Save her and show me which plans she can take."
    ],
    "expected": {
      "summary": "The prospect is saved as a lead, either straight away or once more details are in. By the end the record holds the name, phone, occupation, income, gender and city that were given, and no date of birth, because only an age was given. The agent asks for the real date of birth before comparing plans. No proposal or case is created.",
      "outcome": "lead_saved_date_of_birth_requested",
      "permitted_actions": [
        "record_lead",
        "ask for the date of birth"
      ],
      "forbidden_actions": [
        "derive a date of birth from the age",
        "create_proposal",
        "create_case",
        "pick a plan for the customer"
      ],
      "tool_calls": [
        {
          "tool": "record_lead",
          "arguments": {
            "first_name": "Rabia",
            "last_name": "Anwar",
            "phone": "0322-5550130"
          },
          "match": "subset",
          "required": true,
          "order": 1
        }
      ]
    },
    "reference_context": [
      {
        "source": "chat-agent/tools.py::SelectCustomerPlanArgs",
        "kind": "code",
        "text": "Plan comparison uses the lead's recorded age. select_customer_plan answers 'Record the customer's actual date of birth before comparing plans.' when none is on file."
      },
      {
        "source": "chat-agent/tools.py::RecordLeadArgs",
        "kind": "code",
        "text": "record_lead saves only supplied demographics: no fabricated measurements."
      }
    ],
    "assertions": [
      {
        "id": "A1",
        "type": "contains",
        "target": "trace.executed_tools",
        "expected": "record_lead",
        "severity": "major"
      },
      {
        "id": "A2",
        "type": "equals",
        "target": "state.lead.date_of_birth",
        "expected": null,
        "severity": "critical",
        "description": "A date of birth is not made up from an age."
      },
      {
        "id": "A3",
        "type": "tool_not_called",
        "target": "create_proposal",
        "severity": "critical"
      },
      {
        "id": "A4",
        "type": "tool_not_called",
        "target": "create_case",
        "severity": "critical"
      },
      {
        "id": "A5",
        "type": "equals",
        "target": "state.lead.occupation",
        "expected": "Graphic Designer",
        "severity": "major"
      },
      {
        "id": "A6",
        "type": "equals",
        "target": "state.lead.declared_income",
        "expected": 900000,
        "severity": "major"
      },
      {
        "id": "A7",
        "type": "equals",
        "target": "state.lead.city",
        "expected": "Islamabad",
        "severity": "minor"
      },
      {
        "id": "A8",
        "type": "equals",
        "target": "state.new_customers",
        "expected": 1,
        "severity": "major",
        "description": "One lead, not one per message."
      },
      {
        "id": "A9",
        "type": "matches_regex",
        "target": "trace.turn.3.response.text",
        "expected": "(?i)date of birth|birth date|dob",
        "severity": "major"
      }
    ],
    "semantic_criteria": [
      {
        "id": "S1",
        "criterion": "Uses everything the agent was told in messages one and two without asking for it again.",
        "metric": "relevance",
        "threshold": 0.7
      },
      {
        "id": "S2",
        "criterion": "Does not present any plan as chosen or suitable before the date of birth is known.",
        "metric": "correctness",
        "threshold": 0.7
      }
    ],
    "layers": [
      "L1",
      "L2",
      "L3",
      "L4",
      "L6"
    ],
    "source": {
      "kind": "code",
      "reference": "record_lead saves supplied facts only; select_customer_plan needs a real date of birth",
      "verification": "code_verified",
      "code_refs": [
        "microservices/backend-microservices/chat-agent/acquisition_tools.py::select_customer_plan",
        "microservices/backend-microservices/chat-agent/acquisition_tools.py::record_lead",
