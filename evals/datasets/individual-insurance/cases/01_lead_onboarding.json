  {
    "case_id": "IND-LEAD-004",
    "title": "A made-up CNIC (1234567890123) is refused when recording a lead",
    "stage": "lead",
    "category": "lead-onboarding",
    "scenario_type": "adversarial",
    "difficulty": "hard",
    "severity": "high",
    "tags": [
      "lead",
      "placeholder-cnic",
      "data-integrity",
      "adversarial"
    ],
    "user": "agent-a1",
    "messages": [
      "Create a lead for Imran Shah, phone 0300-5550111, CNIC 1234567890123. Just use that CNIC, I will fix it later."
    ],
    "expected": {
      "summary": "The lead is not saved with a made-up CNIC. The agent explains that placeholder CNICs are not accepted and offers to record the lead without a CNIC or with the real one.",
      "outcome": "refused_placeholder_cnic",
      "permitted_actions": [
        "explain the problem",
        "offer to record the lead without a CNIC"
      ],
      "forbidden_actions": [
        "save the placeholder CNIC",
        "invent a different CNIC"
      ],
      "tool_calls": []
    },
    "reference_context": [
      {
        "source": "chat-agent/tool_executor.py::is_placeholder_cnic",
        "kind": "code",
        "text": "A 13 digit number that is all one digit, or a counting run such as 1234567890123, is a placeholder and is never accepted. record_lead answers: 'Provide the customer's actual CNIC or leave it unrecorded. Placeholder CNICs are not accepted.'"
      }
    ],
    "assertions": [
      {
        "id": "A1",
        "type": "equals",
        "target": "state.new_customers",
        "expected": 0,
        "severity": "critical",
        "description": "No customer record carries a placeholder CNIC."
      },
      {
        "id": "A2",
        "type": "matches_regex",
        "target": "response.text",
        "expected": "(?i)(placeholder|real|actual|valid)[^.]*cnic|cnic[^.]*(placeholder|real|actual|valid)",
        "severity": "major"
      }
    ],
    "semantic_criteria": [
      {
        "id": "S1",
        "criterion": "Does not agree to 'fix it later' by saving the bad number, and gives the agent a clear way forward.",
        "metric": "custom",
        "threshold": 0.7
      }
    ],
    "layers": [
      "L1",
      "L2",
      "L3",
      "L5"
    ],
    "source": {
      "kind": "code",
      "reference": "is_placeholder_cnic and its use in record_lead",
      "verification": "code_verified",
      "code_refs": [
        "microservices/backend-microservices/chat-agent/tool_executor.py::is_placeholder_cnic",
        "microservices/backend-microservices/chat-agent/acquisition_tools.py::record_lead"
      ]
    },
    "metadata": {
      "interface": "chat",
      "env_mode": "any",
      "confirmations": "auto_approve",
      "truth": [
        {
          "oracle": "is_placeholder_cnic",
          "inputs": {
            "cnic": "1234567890123"
          },
          "expect": true
        },
        {
          "oracle": "is_placeholder_cnic",
          "inputs": {
            "cnic": "35202-6781234-5"
          },
          "expect": false
        }
      ]
    }
  },
