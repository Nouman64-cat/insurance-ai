[
  {
    "case_id": "IND-LEAD-001",
    "title": "Agent records a new lead from a name, a phone number and a city",
    "stage": "lead",
    "category": "lead-onboarding",
    "scenario_type": "positive",
    "difficulty": "easy",
    "severity": "medium",
    "tags": [
      "lead",
      "record-lead",
      "agent",
      "acquisition"
    ],
    "user": "agent-a1",
    "messages": [
      "Record a new lead: Farah Naeem, phone 0311-5550120, she lives in Multan."
    ],
    "expected": {
      "summary": "A lead is saved with the name, phone and city exactly as given, assigned to the agent who recorded it. No proposal, case or underwriting step is started.",
      "outcome": "lead_recorded",
      "permitted_actions": [
        "record_lead"
      ],
      "forbidden_actions": [
        "create_proposal",
        "create_case",
        "invent details that were not given"
      ],
      "tool_calls": [
        {
          "tool": "record_lead",
          "arguments": {
            "first_name": "Farah",
            "last_name": "Naeem",
            "phone": "0311-5550120",
            "city": "Multan"
          },
          "match": "subset",
          "required": true,
          "order": 1
        }
      ],
      "routing": {
        "agent": "general_agent",
        "skills": [
          "lead-customer-acquisition"
        ]
      }
    },
    "reference_context": [
      {
        "source": "chat-agent/acquisition_tools.py::record_lead",
        "kind": "code",
        "text": "A lead needs a real first name and a phone of 10 to 15 digits. Only supplied details are saved, the lead is assigned to the signed-in agent, and no proposal, case or underwriting record is created."
      }
    ],
    "assertions": [
      {
        "id": "A1",
        "type": "tool_called",
        "target": "record_lead",
        "severity": "major"
      },
      {
        "id": "A2",
        "type": "equals",
        "target": "trace.tool_calls.record_lead.arguments.phone",
        "expected": "0311-5550120",
        "severity": "major",
        "description": "The phone number is copied exactly."
      },
      {
        "id": "A3",
        "type": "tool_not_called",
        "target": "create_proposal",
        "severity": "critical"
      },
      {
        "id": "A4",
        "type": "tool_not_called",
        "target": "create_case",
        "severity": "critical"
      },
      {
        "id": "A5",
        "type": "equals",
        "target": "state.lead.profile_status",
        "expected": "LEAD",
        "severity": "major"
      },
      {
        "id": "A6",
        "type": "is_true",
        "target": "state.lead.assigned_to_actor",
        "severity": "major"
      },
      {
        "id": "A7",
        "type": "equals",
        "target": "routing.skills",
        "expected": ["lead-customer-acquisition"],
        "severity": "major",
        "description": "An Agent is always served by the acquisition skill, with no specialist."
      },
      {
        "id": "A8",
        "type": "equals",
        "target": "routing.specialist",
        "expected": null,
        "severity": "major"
      }
    ],
    "semantic_criteria": [
      {
        "id": "S1",
        "criterion": "Confirms the lead was recorded and suggests a sensible next step (assessing the lead or comparing plans) without saying a proposal or case exists.",
        "metric": "task_completion",
        "threshold": 0.7
      }
    ],
    "layers": [
      "L1",
      "L2",
      "L3",
      "L4",
      "L6"
    ],
    "source": {
      "kind": "code",
      "reference": "record_lead handler and RecordLeadArgs",
      "verification": "code_verified",
      "code_refs": [
        "microservices/backend-microservices/chat-agent/acquisition_tools.py::record_lead",
        "microservices/backend-microservices/chat-agent/tools.py::RecordLeadArgs",
        "microservices/backend-microservices/tenant-service/routers/customers.py::create_customer"
      ],
      "notes": "A customer with only a name and phone gets profile status LEAD (create_customer: no date of birth, income or occupation)."
    },
    "metadata": {
      "interface": "chat",
      "env_mode": "any",
      "confirmations": "auto_approve",
      "truth": [
        {
          "oracle": "lead_phone_ok",
          "inputs": {
            "phone": "0311-5550120"
          },
          "expect": true
        },
        {
          "oracle": "routing",
          "inputs": {"role": "Agent", "message": "Record a new lead: Farah Naeem, phone 0311-5550120, she lives in Multan."},
          "expect": "general"
        },
        {
          "oracle": "source_contains",
          "inputs": {"path": "microservices/backend-microservices/chat-agent/specialist_router.py", "text": "'selected_skills': ['lead-customer-acquisition']"},
          "expect": true
        }
      ]
    }
  },
  {
    "case_id": "IND-LEAD-002",
    "title": "Agent adds a lead without a phone number, then supplies it",
    "stage": "lead",
    "category": "lead-onboarding",
    "scenario_type": "missing_information",
    "difficulty": "easy",
    "severity": "high",
    "tags": [
      "lead",
      "missing-phone",
      "clarification",
      "multi-turn"
    ],
    "user": "agent-a1",
    "messages": [
      "Add a new lead for Bilal Chaudhry.",
      "His number is 0300-5550142."
    ],
    "expected": {
      "summary": "The first reply asks for the phone number and saves nothing. After the number is given, the lead is saved with it. A phone number is never invented.",
      "outcome": "lead_recorded_after_clarification",
      "permitted_actions": [
        "ask for the phone number",
        "record_lead"
      ],
      "forbidden_actions": [
        "record a lead before a phone number is given",
        "make up a phone number"
      ],
      "tool_calls": [
        {
          "tool": "record_lead",
          "arguments": {
            "first_name": "Bilal",
            "last_name": "Chaudhry",
            "phone": "0300-5550142"
          },
          "match": "subset",
          "required": true,
          "order": 1
        }
      ]
    },
    "reference_context": [
      {
        "source": "chat-agent/tools.py::RecordLeadArgs",
        "kind": "code",
        "text": "phone is a required field described as the customer's actual number: 'Do not invent contact details.'"
      }
    ],
    "assertions": [
      {
        "id": "A1",
        "type": "not_contains",
        "target": "trace.turn.1.executed_tools",
        "expected": "record_lead",
        "severity": "critical",
        "description": "Nothing is saved while the phone number is missing."
      },
      {
        "id": "A1b",
        "type": "not_contains",
        "target": "trace.turn.1.executed_tools",
        "expected": "add_customer",
        "severity": "critical",
        "description": "Nothing is saved while the phone number is missing. A read-only look-up first is fine."
      },
      {
        "id": "A2",
        "type": "matches_regex",
        "target": "trace.turn.1.response.text",
        "expected": "(?i)(phone|mobile|contact number)",
        "severity": "major"
      },
      {
        "id": "A3",
        "type": "contains",
        "target": "trace.turn.2.executed_tools",
        "expected": "record_lead",
        "severity": "major"
      },
      {
        "id": "A4",
        "type": "equals",
        "target": "trace.tool_calls.record_lead.arguments.phone",
        "expected": "0300-5550142",
        "severity": "major"
      }
    ],
    "semantic_criteria": [
      {
        "id": "S1",
        "criterion": "Asks only for what is missing (the phone number) instead of requesting a full customer form.",
        "metric": "relevance",
        "threshold": 0.7
      }
    ],
    "layers": [
      "L1",
      "L2",
      "L3",
      "L4",
      "L6"
    ],
    "source": {
      "kind": "code",
      "reference": "RecordLeadArgs.phone is required; record_lead rejects a missing or malformed phone",
      "verification": "code_verified",
      "code_refs": [
        "microservices/backend-microservices/chat-agent/tools.py::RecordLeadArgs",
        "microservices/backend-microservices/chat-agent/acquisition_tools.py::record_lead"
      ]
    },
    "metadata": {
      "interface": "chat",
      "env_mode": "any",
      "confirmations": "auto_approve",
      "truth": [
        {
          "oracle": "lead_phone_ok",
          "inputs": {
            "phone": "0300-5550142"
          },
          "expect": true
        }
      ]
    }
  },
  {
    "case_id": "IND-LEAD-003",
    "title": "A nine-digit phone number is refused, a full eleven-digit one is accepted",
    "stage": "lead",
    "category": "lead-onboarding",
    "scenario_type": "boundary",
    "difficulty": "medium",
    "severity": "medium",
    "tags": [
      "lead",
      "phone-validation",
      "boundary",
      "multi-turn"
    ],
    "user": "agent-a1",
    "messages": [
      "Record a lead: Hina Raza, phone 030055501, Karachi.",
      "Sorry, I missed some digits. The number is 03005550100."
    ],
    "expected": {
      "summary": "A phone number with 9 digits is below the 10 digit minimum, so no lead is saved and the agent asks for a valid number. Once the full 11 digit mobile number (the usual Pakistani format with the leading 0) is given, the lead is saved. The code's own limit is 10 to 15 digits, so 10 is the boundary it enforces; the corrected number here is 11 digits because that is what a real mobile number has.",
      "outcome": "lead_recorded_after_correction",
      "permitted_actions": [
        "ask for a valid phone number",
        "record_lead"
      ],
      "forbidden_actions": [
        "save the lead with the 9 digit number"
      ],
      "tool_calls": [
        {
          "tool": "record_lead",
          "arguments": {
            "first_name": "Hina",
            "last_name": "Raza",
            "phone": "03005550100",
            "city": "Karachi"
          },
          "match": "subset",
          "required": true,
          "order": 1
        }
      ]
    },
    "reference_context": [
      {
        "source": "chat-agent/acquisition_tools.py::record_lead",
        "kind": "code",
        "text": "The phone may contain digits, spaces, brackets and dashes with an optional leading +, and must hold between 10 and 15 digits."
      }
    ],
    "assertions": [
      {
        "id": "A1",
        "type": "not_contains",
        "target": "trace.turn.1.executed_tools",
        "expected": "record_lead",
        "severity": "critical",
        "description": "No lead is saved with a 9 digit number."
      },
      {
        "id": "A1b",
        "type": "not_contains",
        "target": "trace.turn.1.executed_tools",
        "expected": "add_customer",
        "severity": "critical",
        "description": "No customer is saved with a 9 digit number. A read-only look-up first is fine."
      },
      {
        "id": "A2",
        "type": "contains",
        "target": "trace.turn.2.executed_tools",
        "expected": "record_lead",
        "severity": "major"
      },
      {
        "id": "A3",
        "type": "equals",
        "target": "trace.tool_calls.record_lead.arguments.phone",
        "expected": "03005550100",
        "severity": "major"
      }
    ],
    "semantic_criteria": [
      {
        "id": "S1",
        "criterion": "Explains that the number looks too short and asks for it again, without guessing the missing digit.",
        "metric": "correctness",
        "threshold": 0.7
      }
    ],
    "layers": [
      "L1",
      "L2",
      "L3",
      "L4",
      "L5"
    ],
    "source": {
      "kind": "code",
      "reference": "record_lead phone rule (10 to 15 digits)",
      "verification": "code_verified",
      "code_refs": [
        "microservices/backend-microservices/chat-agent/acquisition_tools.py::record_lead"
      ]
    },
    "metadata": {
      "interface": "chat",
      "env_mode": "any",
      "confirmations": "auto_approve",
      "truth": [
        {
          "oracle": "lead_phone_ok",
          "inputs": {
            "phone": "030055501"
          },
          "expect": false
        },
        {
          "oracle": "lead_phone_ok",
          "inputs": {
            "phone": "0300555010"
          },
          "expect": true
        },
        {
          "oracle": "lead_phone_ok",
          "inputs": {
            "phone": "03005550100"
          },
          "expect": true
        },
        {
          "oracle": "lead_phone_ok",
          "inputs": {
            "phone": "+923001234567890"
          },
          "expect": true
        },
        {
          "oracle": "lead_phone_ok",
          "inputs": {
            "phone": "+9230012345678901"
          },
          "expect": false
        }
      ]
    }
