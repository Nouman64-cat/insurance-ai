      "fixture_refs": ["tenant-sandbox-v1.json"]
    },
    "expected": {
      "summary": "The Finance user belongs to tenant A. Asking for tenant B's payment register is refused with a 403, and nothing from tenant B is returned.",
      "outcome": "forbidden_cross_tenant",
      "forbidden_actions": ["return any payment of another tenant", "reveal whether tenant B has payments"]
    },
    "reference_context": [
      {"source": "tenant-service/routers/claims.py::list_finance_payments", "kind": "code", "text": "The register is for Finance of the same tenant: 'Not your organization or your account is inactive.' (403) for any other tenant."}
    ],
    "assertions": [
      {"id": "A1", "type": "equals", "target": "result.status_code", "expected": 403, "severity": "critical"},
      {"id": "A2", "type": "contains", "target": "result.detail", "expected": "Not your organization", "severity": "major"},
      {"id": "A3", "type": "not_contains", "target": "result.body", "expected": "payee_name", "severity": "critical", "description": "No payment record is returned."}
    ],
    "layers": ["L1", "L4", "L5"],
    "source": {"kind": "code", "reference": "list_finance_payments tenant check", "verification": "code_verified",
      "code_refs": ["microservices/backend-microservices/tenant-service/routers/claims.py::list_finance_payments"]},
    "metadata": {"interface": "api", "env_mode": "any",
      "truth": [{"oracle": "source_contains", "inputs": {"path": "microservices/backend-microservices/tenant-service/routers/claims.py", "text": "Not your organization or your account is inactive."}, "expect": true}]}
  },
  {
    "case_id": "IND-SEC-006",
    "title": "One agent cannot continue another agent's conversation",
    "stage": "security", "category": "security-rbac", "scenario_type": "conflicting_data", "difficulty": "hard", "severity": "critical",
    "tags": ["security", "thread-ownership", "chat", "session-isolation"],
    "user": "agent-a2",
    "input": {
      "payload": {"operation": "chat.stream", "thread_of": "agent-a1", "message": "Continue where we left off and finish the pending step."},
      "fixture_refs": ["tenant-sandbox-v1.json"]
    },
    "expected": {
      "summary": "Agent A1 started a conversation and left a step paused. Agent A2 sends a message into that thread. The service refuses with a 403 that the conversation belongs to another user, and A1's paused step is neither resumed nor run with A1's saved token.",
      "outcome": "forbidden_not_thread_owner",
      "forbidden_actions": ["continue the thread", "resume the paused step", "reveal what the thread contained"]
    },
    "reference_context": [
      {"source": "chat-agent/routers/chat.py::_owner_mismatch", "kind": "code", "text": "A conversation belongs to the user who started it. Another user's thread is never continued or resumed: 'This conversation belongs to another user.' (403)."}
    ],
    "assertions": [
      {"id": "A1", "type": "equals", "target": "result.status_code", "expected": 403, "severity": "critical"},
      {"id": "A2", "type": "equals", "target": "result.detail", "expected": "This conversation belongs to another user.", "severity": "major"},
      {"id": "A3", "type": "equals", "target": "state.thread.agent-a1.paused_step_executed", "expected": false, "severity": "critical"}
    ],
    "layers": ["L1", "L4", "L5"],
    "source": {"kind": "code", "reference": "thread ownership check in the chat stream and resume endpoints", "verification": "code_verified",
      "code_refs": ["microservices/backend-microservices/chat-agent/routers/chat.py::_owner_mismatch", "microservices/backend-microservices/chat-agent/routers/chat.py::chat_stream"]},
    "metadata": {"interface": "api", "env_mode": "any",
      "truth": [{"oracle": "source_contains", "inputs": {"path": "microservices/backend-microservices/chat-agent/routers/chat.py", "text": "This conversation belongs to another user."}, "expect": true}]}
  },
