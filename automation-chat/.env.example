# Browser-facing URLs (host ports)
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_OCR_URL=http://localhost:8014
NEXT_PUBLIC_SUMMARIZER_URL=http://localhost:8015
# The manual dashboard. Embedded pages, "back to dashboard" and the sign-in redirect use it.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Single sign-on cookie (must match the portal's). Leave SSO_COOKIE_DOMAIN empty on localhost; set it to the shared
# parent domain (e.g. .insurance.example.com) when the portal and this app live on different subdomains.
SSO_COOKIE_NAME=insurance_sso
SSO_COOKIE_DOMAIN=
