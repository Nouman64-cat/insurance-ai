# Copy to repository root as .env.production. Replace every placeholder and keep it out of Git.
# Do not commit real credentials. Generate random secrets with a password manager.
APP_DOMAIN=example.com
TLS_EMAIL=ops@example.com
ENV_VAR=production
AWS_REGION=eu-south-1
AWS_S3_REGION=eu-south-1
S3_BUCKET_NAME=replace-with-terraform-app-bucket
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SHARED_SECRET
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
INTERNAL_API_SECRET=REPLACE_WITH_LONG_RANDOM_SHARED_SECRET
CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com,https://portal.example.com,https://underwriting.example.com,https://claims.example.com,https://support.example.com,https://automation.example.com

# PostgreSQL should be a separate managed PostgreSQL deployment reachable from this EC2 host.
# URL-encode reserved characters in passwords. Ensure DB security groups only allow this host.
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:REPLACE_ME@db.example.internal:5432/insurance-ai
DATABASE_URL=postgresql+asyncpg://tenant_app:REPLACE_ME@db.example.internal:5432/insurance-ai
REQUEST_MGMT_DATABASE_URL=postgresql+asyncpg://request_mgmt_app:REPLACE_ME@db.example.internal:5432/insurance-ai
REQUEST_MGMT_MIGRATION_DATABASE_URL=postgresql+asyncpg://request_mgmt_owner:REPLACE_ME@db.example.internal:5432/insurance-ai
REQUEST_MGMT_DB_OWNER_PASSWORD=REPLACE_ME
REQUEST_MGMT_DB_APP_PASSWORD=REPLACE_ME
CM_DATABASE_URL=postgresql+asyncpg://customer_management_app:REPLACE_ME@db.example.internal:5432/insurance-ai
CM_MIGRATION_DATABASE_URL=postgresql+asyncpg://customer_management_owner:REPLACE_ME@db.example.internal:5432/insurance-ai
CM_DB_OWNER_PASSWORD=REPLACE_ME
CM_DB_APP_PASSWORD=REPLACE_ME
CS_DATABASE_URL=postgresql+asyncpg://customer_service_app:REPLACE_ME@db.example.internal:5432/insurance-ai
CS_MIGRATION_DATABASE_URL=postgresql+asyncpg://customer_service_owner:REPLACE_ME@db.example.internal:5432/insurance-ai
CS_DB_OWNER_PASSWORD=REPLACE_ME
CS_DB_APP_PASSWORD=REPLACE_ME
AUDIT_DATABASE_URL=postgresql+asyncpg://audit_app:REPLACE_ME@db.example.internal:5432/insurance-ai
AUDIT_MIGRATION_DATABASE_URL=postgresql+asyncpg://audit_owner:REPLACE_ME@db.example.internal:5432/insurance-ai
AUDIT_DB_OWNER_PASSWORD=REPLACE_ME
AUDIT_DB_APP_PASSWORD=REPLACE_ME
AUDIT_DB_SIGNER_PASSWORD=REPLACE_ME
AUDIT_SIGNER_DATABASE_URL=postgresql+asyncpg://audit_signer:REPLACE_ME@db.example.internal:5432/insurance-ai

# Current tenant-service code receives explicit AWS keys. Prefer a later code change to use the EC2 role.
AWS_ACCESS_KEY_ID=REPLACE_WITH_IAM_USER_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_USER_SECRET
OPENSANCTIONS_API_KEY=REPLACE_ME
EMAIL_PROVIDER=ses
AWS_SES_FROM_EMAIL=no-reply@example.com
AWS_SES_USERNAME=REPLACE_WITH_SES_SMTP_USERNAME
AWS_SES_PASSWORD=REPLACE_WITH_SES_SMTP_PASSWORD
APP_LOGIN_URL=https://portal.example.com/login
REQUEST_MGMT_SERVICE_KEY=REPLACE_WITH_RANDOM_SECRET
CUSTOMER_PORTAL_URL=https://portal.example.com/login
CS_PORTAL_KEY=REPLACE_WITH_RANDOM_SECRET
CS_OPEN_DESK=false
CS_OPEN_DESK_TENANT_ID=
CM_WALKIN_TENANT_CODE=
PORTAL_PROVISIONING_MODE=dual
PORTAL_COOKIE_SECURE=true
SSO_COOKIE_NAME=insurance_sso
SSO_COOKIE_DOMAIN=.example.com
CLAIMS_COOKIE_NAME=claims_manager_session
AUDIT_ENABLED=true
AUDIT_SIGNER_SERVICE_KEY=REPLACE_WITH_RANDOM_SECRET
AUDIT_SIGNER_ID=insurance-ai-production
AUDIT_TRUST_ANCHOR_FINGERPRINT=
AUDIT_SIGNING_ENABLED=true
AUDIT_SIGNING_PROVIDER=local
AUDIT_ARCHIVING_ENABLED=true
AUDIT_ARCHIVE_STORAGE_PROVIDER=minio
AUDIT_ARCHIVE_S3_ENDPOINT=http://minio:9000
AUDIT_ARCHIVE_BUCKET=insurance-audit-archive
AUDIT_ARCHIVE_WRITER_KEY=REPLACE_ME
AUDIT_ARCHIVE_WRITER_SECRET=REPLACE_ME
AUDIT_ARCHIVE_READER_KEY=REPLACE_ME
AUDIT_ARCHIVE_READER_SECRET=REPLACE_ME
AUDIT_ARCHIVE_LOCK_MODE=GOVERNANCE
AUDIT_ARCHIVE_LOCK_DAYS=30
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_WITH_16_PLUS_CHAR_SECRET
AISTOR_LICENSE_FILE=/etc/insurance-ai/minio.license

# Set these URLs to match the DNS records and Caddy hostnames configured above.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_OCR_URL=https://ocr.example.com
NEXT_PUBLIC_PORTAL_URL=https://portal.example.com
NEXT_PUBLIC_UNDERWRITING_URL=https://underwriting.example.com
NEXT_PUBLIC_AUTOMATION_URL=https://automation.example.com
NEXT_PUBLIC_CLAIMS_URL=https://claims.example.com
NEXT_PUBLIC_CUSTOMER_SERVICE_URL=https://support.example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_REQUESTS_URL=
NEXT_PUBLIC_WALKIN_DEMO=false
UNDERWRITING_PROD_URL=https://underwriting.example.com
