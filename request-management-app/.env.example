# Native development. Docker must use http://api-gateway:8000 for the internal URL.
NEXT_PUBLIC_API_URL=http://localhost:8010
API_GATEWAY_INTERNAL_URL=http://localhost:8010
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_REQUESTS_URL=http://localhost:3007
SSO_COOKIE_NAME=insurance_sso
# For HTTPS subdomains, set the same parent domain on all apps.
SSO_COOKIE_DOMAIN=
